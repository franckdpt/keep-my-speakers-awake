{
  "name": "kmsa",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check:native": "node scripts/check-native.mjs",
    "build": "node native/scripts/build.mjs",
    "package:dmg": "node scripts/package-dmg.mjs",
    "publish:release": "node scripts/publish-release.mjs",
    "build:app-store": "KMSA_DISTRIBUTION=app-store node native/scripts/build.mjs",
    "package:app-store": "node scripts/package-app-store.mjs",
    "notarize:app": "node scripts/notarize.mjs",
    "screenshots:app-store": "swift scripts/store-screenshots.swift"
  },
  "engines": {
    "node": ">=24"
  }
}
